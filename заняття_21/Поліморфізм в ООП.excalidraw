      "fontSize": 22,
      "fontFamily": 5,
      "text": "class Animal:\n    def speak(self):\n        pass\n\nclass Dog(Animal):\n    def speak(self): return \"Гав!\"\n\nclass Cat(Animal):\n    def speak(self): return \"Няв!\"\n\nfor animal in [Dog(), Cat()]:\n    print(animal.speak())",
      "originalText": "class Animal:\n    def speak(self):\n        pass\n\nclass Dog(Animal):\n    def speak(self): return \"Гав!\"\n\nclass Cat(Animal):\n    def speak(self): return \"Няв!\"\n\nfor animal in [Dog(), Cat()]:\n    print(animal.speak())",
