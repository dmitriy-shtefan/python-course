      "text": "✅ З ІНКАПСУЛЯЦІЄЮ: PYTHON",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "✅ З ІНКАПСУЛЯЦІЄЮ: PYTHON",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "code",
      "type": "text",
      "x": 665,
      "y": 525,
      "width": 500,
      "height": 225,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aV",
      "roundness": null,
      "seed": 603,
      "version": 2,
      "versionNonce": 1284481121,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784496108708,
      "link": null,
      "locked": false,
      "text": "class BankAccount:\n    def __init__(self, balance):\n        self.__balance = balance   # приховано\n\n    def withdraw(self, amount):   # безпечна кнопка\n        if 0 < amount <= self.__balance:\n            self.__balance -= amount\n            return 'Гроші видано ✅'\n        return 'Операцію заборонено 🔒'",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class BankAccount:\n    def __init__(self, balance):\n        self.__balance = balance   # приховано\n\n    def withdraw(self, amount):   # безпечна кнопка\n        if 0 < amount <= self.__balance:\n            self.__balance -= amount\n            return 'Гроші видано ✅'\n        return 'Операцію заборонено 🔒'",
      "autoResize": true,
      "lineHeight": 1.25
    },
